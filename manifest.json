{
  "manifest_version": 3,
  "name": "PhoText - Edit Text in Image & Find Font",
  "short_name": "PhoText",
  "version": "1.0.0",
  "description": "Right-click any image to edit, remove or translate its text, or identify its font, with PhoText (photext.ai).",
  "homepage_url": "https://photext.ai",
  "permissions": ["contextMenus"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "browser_specific_settings": { "gecko": { "id": "extension@photext.ai", "strict_min_version": "142.0", "data_collection_permissions": { "required": ["none"] } } }
}
